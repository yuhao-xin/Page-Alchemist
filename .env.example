# ============================================================
#  Notion Alchemist — configuration
#  Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================

# ---- Official Notion API (PRIMARY engine) ------------------
# 1. Create an integration: https://www.notion.so/my-integrations
#    (you must be a Workspace Owner)
# 2. Open the source page -> "..." -> Connections -> add your integration.
#    Child pages inherit the share. Skipping this step makes the API
#    return 404 for the page.
NOTION_TOKEN=

# ---- Unofficial engine (EXPERIMENTAL, optional) ------------
# `token_v2` cookie from a logged-in browser session on notion.so.
# Only needed for pages you can VIEW but cannot share with an
# integration (e.g. guest access to a paid template library).
# Treat it like a password: it IS your login session, and it dies
# when you log out or change your password.
NOTION_TOKEN_V2=

# ---- Publish target ----------------------------------------
# Page ID or URL of the parent page in YOUR workspace where
# clones will be created. Also share THIS page with the integration.
NA_PARENT_PAGE=

# ---- Feishu / Lark publish (na publish-feishu) -------------
# Create a custom app at https://open.feishu.cn/app and grant the
# docx:document + drive:drive + drive:file:upload scopes (publish a
# version afterwards). See docs/feishu-publish.md.
NA_FEISHU_APP_ID=
NA_FEISHU_APP_SECRET=
# Optional: folder token (fld...) to create documents in.
# NA_FEISHU_FOLDER=
# Optional: switch to Lark (international): https://open.larksuite.com
# NA_FEISHU_BASE=https://open.feishu.cn

# ---- Defaults ----------------------------------------------
# Icon strategy on publish: keep | retune | none
NA_ICON_MODE=retune
NA_HTTP_TIMEOUT=30
NA_MAX_RPS=2.5
NA_LOG_LEVEL=INFO
# Working directory for IR JSON, reports and assets.
# Defaults to the CLI's --output value (default: output).
# NA_OUTPUT_DIR=output
# Where the resumable .na_state.json lives. Defaults to the --output
# directory so each working copy is self-contained; set this to pin it.
# NA_STATE_DIR=output
# Optional file-upload token (leave empty unless Notion asks for one).
# NOTION_FILE_TOKEN=
